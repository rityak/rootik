{
  "name": "rootik",
  "version": "1.0.0-beta.2",
  "description": "Dark-first React UI toolkit for dashboards, panels and desktop clients",
  "license": "MIT",
  "author": "Ritya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rityak/rootik.git"
  },
  "homepage": "https://github.com/rityak/rootik#readme",
  "bugs": "https://github.com/rityak/rootik/issues",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "dark",
    "dashboard"
  ],
  "type": "module",
  "packageManager": "bun@1.3.11",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./overlays": {
      "types": "./dist/overlays/index.d.ts",
      "source": "./src/overlays/index.ts",
      "default": "./dist/overlays/index.js"
    },
    "./overlays/styles.css": {
      "source": "./src/css/overlays.css",
      "default": "./dist/css/overlays.css"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "source": "./src/forms/index.ts",
      "default": "./dist/forms/index.js"
    },
    "./forms/styles.css": {
      "source": "./src/css/forms.css",
      "default": "./dist/css/forms.css"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "source": "./src/motion/index.ts",
      "default": "./dist/motion/index.js"
    },
    "./motion/styles.css": {
      "source": "./src/css/motion.css",
      "default": "./dist/css/motion.css"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "source": "./src/controls/index.ts",
      "default": "./dist/controls/index.js"
    },
    "./controls/styles.css": {
      "source": "./src/css/controls.css",
      "default": "./dist/css/controls.css"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "source": "./src/navigation/index.ts",
      "default": "./dist/navigation/index.js"
    },
    "./navigation/styles.css": {
      "source": "./src/css/navigation.css",
      "default": "./dist/css/navigation.css"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "source": "./src/layout/index.ts",
      "default": "./dist/layout/index.js"
    },
    "./layout/styles.css": {
      "source": "./src/css/layout.css",
      "default": "./dist/css/layout.css"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "source": "./src/theme/index.ts",
      "default": "./dist/theme/index.js"
    },
    "./fonts.css": {
      "source": "./src/fonts.css",
      "default": "./dist/fonts.css"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./tailwind.css": {
      "source": "./src/tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./css/tokens.css": {
      "source": "./src/css/tokens.css",
      "default": "./dist/css/tokens.css"
    },
    "./css/rain.css": {
      "source": "./src/css/rain.css",
      "default": "./dist/css/rain.css"
    },
    "./css/base.css": {
      "source": "./src/css/base.css",
      "default": "./dist/css/base.css"
    },
    "./css/*.css": {
      "source": "./src/css/*.css",
      "default": "./dist/css/*.css"
    },
    "./labels/en": {
      "types": "./dist/labels/en.d.ts",
      "source": "./src/labels/en.ts",
      "default": "./dist/labels/en.js"
    },
    "./labels/ru": {
      "types": "./dist/labels/ru.d.ts",
      "source": "./src/labels/ru.ts",
      "default": "./dist/labels/ru.js"
    },
    "./package.json": "./package.json",
    "./data": {
      "types": "./dist/data/index.d.ts",
      "source": "./src/data/index.ts",
      "default": "./dist/data/index.js"
    },
    "./data/styles.css": {
      "source": "./src/css/data.css",
      "default": "./dist/css/data.css"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "source": "./src/content/index.ts",
      "default": "./dist/content/index.js"
    },
    "./content/styles.css": {
      "source": "./src/css/content.css",
      "default": "./dist/css/content.css"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "source": "./src/charts/index.ts",
      "default": "./dist/charts/index.js"
    },
    "./charts/styles.css": {
      "source": "./src/css/charts.css",
      "default": "./dist/css/charts.css"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "source": "./src/feedback/index.ts",
      "default": "./dist/feedback/index.js"
    },
    "./feedback/styles.css": {
      "source": "./src/css/feedback.css",
      "default": "./dist/css/feedback.css"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/stories",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "styles": "bun scripts/styles.ts",
    "styles:check": "bun scripts/styles.ts --check",
    "check:pilot": "bun run build && bun scripts/check-pilot.ts",
    "build:stories": "bun run styles && ladle build",
    "build:design-lab": "bun run styles && vite build --config design-lab/vite.config.ts && bun design-lab/check-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write . && bun run styles && bun scripts/llms.ts",
    "test": "bun test ./src && bun run test:dom",
    "test:dom": "bun test --preload ./scripts/dom-setup.ts ./tests/dom",
    "check": "bun run styles:check && bun run typecheck && bun run lint && bun run test",
    "build": "bun scripts/build.ts && bun scripts/check-dist.ts",
    "prepublishOnly": "bun run check && bun run llms && bun run build",
    "llms": "bun scripts/llms.ts",
    "visual": "playwright test"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/rubik": "5.3.0",
    "@happy-dom/global-registrator": "^20.14.6",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "csstype": "3.2.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.3",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
