{
  "name": "rootik",
  "version": "0.2.0",
  "description": "Dark-first React UI toolkit for dashboards, panels and desktop clients",
  "license": "MIT",
  "author": "Ritya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rityak/rootik.git"
  },
  "homepage": "https://github.com/rityak/rootik#readme",
  "bugs": "https://github.com/rityak/rootik/issues",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "dark",
    "dashboard"
  ],
  "type": "module",
  "packageManager": "bun@1.3.11",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./css/tokens.css": {
      "source": "./src/tokens.css",
      "default": "./dist/css/tokens.css"
    },
    "./css/base.css": {
      "source": "./src/base.css",
      "default": "./dist/css/base.css"
    },
    "./css/*.css": {
      "source": "./src/components/*.css",
      "default": "./dist/css/*.css"
    },
    "./labels/en": {
      "types": "./dist/labels/en.d.ts",
      "source": "./src/labels/en.ts",
      "default": "./dist/labels/en.js"
    },
    "./labels/ru": {
      "types": "./dist/labels/ru.d.ts",
      "source": "./src/labels/ru.ts",
      "default": "./dist/labels/ru.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/stories",
    "!src/**/*.test.ts",
    "llms.txt"
  ],
  "scripts": {
    "dev": "ladle serve",
    "build:stories": "ladle build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write . && bun scripts/llms.ts",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "build": "bun scripts/build.ts && bun scripts/check-dist.ts",
    "prepublishOnly": "bun run check && bun run llms && bun run build",
    "llms": "bun scripts/llms.ts",
    "visual": "playwright test"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
